@model Book

@{
    ViewData["Title"] = "Подробнее о книге";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h1>@Model.Title</h1>
    <p><strong>Автор:</strong> @Model.Author</p>
    <p><strong>Описание:</strong> @Model.Description</p>
    <p><strong>Цена:</strong> @Model.Price руб.</p>

    <a href="@Url.Action("Index")" class="btn btn-secondary">Вернуться</a>
</div>