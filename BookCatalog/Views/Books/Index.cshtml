@model IEnumerable<BookCatalog.Models.Book>
@{
    ViewData["Title"] = "Каталог";
    Layout = "_Layout";
}

<h1 class="mb-4">Каталог книг</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Книг пока нет. Перейдите в админку, чтобы добавить.</div>
}
else
{
    <div class="row g-4">
        @foreach (var book in Model)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card h-100 book-card">
                    @if (!string.IsNullOrEmpty(book.CoverUrl))
                    {
                        <img src="@book.CoverUrl" class="card-img-top book-cover" alt="@book.Title" />
                    }
                    else
                    {
                        <div class="book-cover-placeholder">📖</div>
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@book.Title</h5>
                        <p class="text-muted mb-1">@book.Author</p>
                        <p class="text-muted small">@book.Genre · @book.Year</p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="fw-bold">@book.Price.ToString("0") ₽</span>
                            <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-primary">Подробнее</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}