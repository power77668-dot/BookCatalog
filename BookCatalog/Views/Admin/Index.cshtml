@model IEnumerable<BookCatalog.Models.Book>
@{
    ViewData["Title"] = "Админка";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Управление каталогом</h1>
    <a asp-action="Create" class="btn btn-success">+ Добавить книгу</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Автор</th>
                <th>Жанр</th>
                <th>Год</th>
                <th>Цена</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Genre</td>
                    <td>@book.Year</td>
                    <td>@book.Price.ToString("0") ₽</td>
                    <td class="text-end">
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info">👁</a>
                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">✏</a>
                        <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">🗑</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>